{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run Lunar Lander",
            "type": "shell",
            "command": "clang -Wall -Wextra -g LL.c -o lunarlander $(pkg-config --cflags --libs raylib) && ./lunarlander",
            "command": "clang -Wall -Wextra -g LL.c rotation.c -o lunarlander $(pkg-config --cflags --libs raylib) && ./lunarlander",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}